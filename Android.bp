soong_namespace {
    imports: [
        "vendor/nothing/NanoGlyph",
        "packages/apps/GlyphBridge",
    ],
}

java_defaults {
    name: "HieroGlyph_defaults",

    srcs: [
        "src/**/*.java",
        "src/**/*.kt"
    ],

    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,

    resource_dirs: ["res"],
    static_libs: [
        "androidx.core_core",
        "androidx.preference_preference",
        "com.google.android.material_material",
        "SettingsLib",
        "IGlyphService-java",
        "vendor.nukisystems.nanoglyph-V1-java",
    ],

    required: [
        "privapp_whitelist_org.nukisystems.hieroglyph.xml",
        "vendor.nukisystems.nanoglyph.matrix-service",
        "whitelist_org.nukisystems.hieroglyph.xml",
        "GlyphBridge"
    ],

    optimize: {
        enabled: false, 
    }
}

android_app {
    name: "HieroGlyphMetroid",
    defaults: ["HieroGlyph_defaults"],
    asset_dirs: ["Metroid/assets"],
    resource_dirs: ["Metroid/res"],
}

android_app {
    name: "HieroGlyphFroggerPro",
    defaults: ["HieroGlyph_defaults"],
    asset_dirs: ["FroggerPro/assets"],
    resource_dirs: ["FroggerPro/res"],
}

prebuilt_etc {
    name: "privapp_whitelist_org.nukisystems.hieroglyph.xml",
    src: "permissions/privapp_whitelist_org.nukisystems.hieroglyph.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "whitelist_org.nukisystems.hieroglyph.xml",
    src: "permissions/whitelist_org.nukisystems.hieroglyph.xml",
    sub_dir: "sysconfig",
    system_ext_specific: true,
}
